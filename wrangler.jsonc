{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The top level is the local environment (`wrangler dev`).
  "name": "kan-game-local",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-01",
  // The portal's pages. Only /api/* reaches the Worker. Inherited by env.dev.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kan-game-local",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "ISSUE_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      // Shared by the redeem APIs; each keys its count as `<api>:<ip>`.
      "name": "REDEEM_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  // Daily (UTC): cleans up expired transfer codes and migration tokens, and
  // retries deletions a game outage interrupted.
  // Inherited by env.dev, unlike the bindings.
  "triggers": { "crons": ["0 18 * * *"] },
  "vars": {
    // Whether browsers accept a `__Secure-` cookie on http://localhost is still
    // to be checked in R1 (docs/ID_DESIGN.md「ローカルの開発」).
    "COOKIE_NAME": "__Secure-kgdev_id",
    // Empty: the cookie is host-only (localhost).
    "COOKIE_DOMAIN": "",
    "ISSUER": "localhost",
    // The games' origins (comma separated). The portal is always allowed.
    // To call the ID APIs from a game served locally on another port, add its
    // origin here or in .dev.vars, e.g. "http://localhost:5173".
    "ALLOWED_ORIGINS": "",
    // The only origin allowed to call the recovery code and deletion APIs.
    "PORTAL_ORIGIN": "http://localhost:8787",
    // The GAME_<NAME> bindings asked to delete records on account deletion
    // (comma separated, in calling order).
    "GAMES": "",
    // Overridden by .dev.vars (`npm run generate-key -- --dev-vars`).
    "ID_PUBLIC_KEYS": "[]",
  },
  "secrets": {
    "required": ["ID_SIGNING_KEY"],
  },
  // Each game is a service binding named GAME_<NAME>, e.g.
  //   "services": [{ "binding": "GAME_TAKO", "service": "<the game's Worker>", "entrypoint": "..." }]
  // and is listed in the GAMES var. Deleting an ID calls deleteAccount(id) on
  // each listed binding in order; a listed binding that is missing fails the
  // deletion (docs/ID_DESIGN.md「退会」). Not inherited by env.dev.
  "observability": {
    "enabled": true,
  },
  "env": {
    "dev": {
      "name": "kan-game-dev",
      "routes": [{ "pattern": "dev.kan-game.app", "custom_domain": true }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kan-game-dev",
          "database_id": "bcfe7af2-d732-45bd-a2ac-00c19dd36bc8",
          "migrations_dir": "migrations",
        },
      ],
      "ratelimits": [
        {
          "name": "ISSUE_RATE_LIMITER",
          "namespace_id": "1101",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "REDEEM_RATE_LIMITER",
          "namespace_id": "1102",
          "simple": { "limit": 5, "period": 60 },
        },
      ],
      // TAKO-SEN's development Worker (tako-dev.kan-game.app). Its GameService
      // entrypoint provides deleteAccount(id).
      "services": [
        {
          "binding": "GAME_TAKO",
          "service": "tako-dev",
          "entrypoint": "GameService",
        },
      ],
      "vars": {
        "COOKIE_NAME": "__Secure-kgdev_id",
        "COOKIE_DOMAIN": "kan-game.app",
        "ISSUER": "dev.kan-game.app",
        "ALLOWED_ORIGINS": "https://tako-dev.kan-game.app",
        "PORTAL_ORIGIN": "https://dev.kan-game.app",
        "GAMES": "GAME_TAKO",
        // JSON array of public JWKs, each with kid. To rotate, follow
        // docs/ID_DESIGN.md「鍵の管理」.
        "ID_PUBLIC_KEYS": "[{\"kid\":\"2026-10-18-2515ed\",\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"0KpEL8A2l9DupwZ2uVJVr_ZGy-sRbGJcJg-2Wwi8McU\",\"y\":\"yMVIO135BT3klr-T0Xtr4cRkdkAvfkwxAMaTzoH5EC4\"}]",
      },
      // Not inherited from the top level.
      "secrets": {
        "required": ["ID_SIGNING_KEY"],
      },
    },
  },
}
