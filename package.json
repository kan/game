{
  "name": "kan-game",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./token": "./src/token.ts",
    "./rpc": "./src/rpc.ts",
    "./name-rules": "./src/name-rules.ts",
    "./testing/fake-id-platform": "./testing/fake-id-platform.ts",
    "./testing/test-id-cookie": "./testing/test-id-cookie.ts",
    "./test-vectors/id-token.json": "./test-vectors/id-token.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/token.ts",
    "src/rpc.ts",
    "src/name-rules.ts",
    "testing/",
    "test-vectors/"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:production": "wrangler deploy --env production && npm run tag:production",
    "tag:production": "node -e \"const{execSync:x}=require('child_process');const t='production-'+new Date().toISOString().replace(/[-:]/g,'').slice(0,15);x('git tag -f production');x('git tag '+t);x('git push -f origin refs/tags/production refs/tags/'+t,{stdio:'inherit'})\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.public.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types --strict-vars=false",
    "generate-key": "node scripts/generate-signing-key.mjs",
    "generate-vectors": "node scripts/generate-test-vectors.mjs && prettier --write test-vectors",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.151.1"
  }
}
